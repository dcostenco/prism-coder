# ╔══════════════════════════════════════════════════════════════════╗
# ║  Prism MCP — Environment Variables (.env.example)              ║
# ║  Copy this file to .env and fill in your keys.                 ║
# ║  Docs: https://github.com/dcostenco/prism-coder              ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Required: API Keys ────────────────────────────────────────────
# Brave Search Pro — powers web search and research tools
# Get yours at: https://brave.com/search/api/
BRAVE_API_KEY=

# Google AI Studio — powers Gemini LLM (synthesis, embeddings, images)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ─── Optional: Brave Answers ───────────────────────────────────────
# Separate key for AI-grounded answers (brave_answers tool)
# BRAVE_ANSWERS_API_KEY=

# ─── Optional: You.com Search ──────────────────────────────────────
# Enables the optional youcom_web_search tool as an alternative web
# search provider alongside the built-in Brave search tools.
# Get a key at: https://you.com/platform/api-keys
# YDC_API_KEY=

# ─── Storage ───────────────────────────────────────────────────────
# "local" = SQLite (zero-config, good for dev)
# "supabase" = Supabase PostgreSQL (production, multi-device)
PRISM_STORAGE=local

# For Supabase storage, set these:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Dashboard ─────────────────────────────────────────────────────
PRISM_DASHBOARD_PORT=3333
# PRISM_DASHBOARD_AUTH=your-secret-password  # Optional: password-protect the dashboard

# ─── Dashboard Authentication (v9.1) ──────────────────────────────
# Basic Auth — set both to enable username/password login
# PRISM_DASHBOARD_USER=admin
# PRISM_DASHBOARD_PASS=your-secret-password

# JWKS JWT Auth — vendor-neutral (Auth0, Cognito, Keycloak, etc.)
# Set PRISM_JWKS_URI to your identity provider's JWKS endpoint
# PRISM_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# PRISM_JWT_AUDIENCE=prism-dashboard         # Recommended: prevents cross-service token confusion
# PRISM_JWT_ISSUER=https://your-tenant.auth0.com/  # Optional: validate token issuer

# ─── Background Scheduler (v5.4) ──────────────────────────────────
# Runs maintenance tasks: TTL sweep, importance decay, compaction, deep purge
PRISM_SCHEDULER_ENABLED=true
# PRISM_SCHEDULER_INTERVAL_MS=43200000  # Default: 12 hours

# ─── Autonomous Web Scholar (v5.4) ────────────────────────────────
# Background research pipeline: discovery → local scrape → LLM synthesis → Ledger
#
# Discovery uses web search when one is available — Synalux portal credentials
# (server-side, no key of yours) or your own BRAVE_API_KEY. With neither it uses
# the free academic path (PubMed + ERIC + Semantic Scholar, then Yahoo), so no
# key is required at all. GOOGLE_API_KEY here is the AI Studio key for LLM
# synthesis; it is not a search key.
#
# FIRECRAWL_API_KEY is currently unused: Scholar scrapes with its own local
# scraper and discovery does not consult this key. Kept so existing .env files
# do not break. https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# Enable the Scholar pipeline
PRISM_SCHOLAR_ENABLED=true

# PRISM_SCHOLAR_INTERVAL_MS has no effect on a local install: the client-side
# auto-scheduler was retired in v18.0.0. Runs start from the dashboard button
# or the scholar_research tool; scheduled runs come from the portal cron.
# PRISM_SCHOLAR_INTERVAL_MS=0

# Comma-separated research topics
PRISM_SCHOLAR_TOPICS=ai,agents

# Max articles scraped per run (controls API costs)
PRISM_SCHOLAR_MAX_ARTICLES_PER_RUN=3

# ─── Telemetry (optional) ─────────────────────────────────────────
# OpenTelemetry endpoint for distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ─── Debug ─────────────────────────────────────────────────────────
# Set to "true" for verbose logging (Scholar pipeline, embedding ops, etc.)
# DEBUG=true
